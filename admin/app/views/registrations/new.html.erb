<% content_for :title, t("auth.sign_up") %>

<div class="max-w-md mx-auto py-8">
  <div class="rounded-xl border border-base-200/80 bg-base-100/60 p-6 sm:p-8 space-y-6">
    <div class="space-y-1 text-center">
      <h1 class="text-2xl font-bold tracking-tight text-base-content">
        <%= t("auth.sign_up") %>
      </h1>
      <p class="text-xs text-base-content/60">
        <%= t("auth.sign_up_desc") %>
      </p>
    </div>

    <% if alert = flash[:alert] %>
      <div class="p-3 rounded-lg border border-error/30 bg-error/10 text-error text-xs font-medium" id="alert">
        <%= alert %>
      </div>
    <% end %>

    <% if @user.errors.any? %>
      <div class="p-3 rounded-lg border border-error/30 bg-error/10 text-error text-xs font-medium space-y-1">
        <ul class="list-disc list-inside space-y-0.5">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: registration_url, class: "space-y-4" do |form| %>
      <div class="space-y-1.5">
        <%= form.label :email_address, t("auth.email"), class: "text-xs font-medium text-base-content/80" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "input input-bordered w-full rounded-md text-sm bg-base-100/70" %>
      </div>

      <div class="space-y-1.5">
        <%= form.label :password, t("auth.password"), class: "text-xs font-medium text-base-content/80" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "••••••••", maxlength: 72, class: "input input-bordered w-full rounded-md text-sm bg-base-100/70" %>
      </div>

      <div class="space-y-1.5">
        <%= form.label :password_confirmation, t("auth.password_confirm"), class: "text-xs font-medium text-base-content/80" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "••••••••", maxlength: 72, class: "input input-bordered w-full rounded-md text-sm bg-base-100/70" %>
      </div>

      <div class="pt-2">
        <%= form.submit t("auth.sign_up_button"), class: "btn btn-primary w-full rounded-md font-medium text-sm cursor-pointer" %>
      </div>
    <% end %>

    <div class="pt-4 border-t border-base-200/80 text-center space-y-2">
      <p class="text-xs text-base-content/70">
        <%= t("auth.already_have_account") %>
        <%= link_to t("auth.sign_in_now"), new_session_path, class: "text-primary font-medium hover:underline ml-1" %>
      </p>
      <p class="text-xs">
        <%= link_to t("auth.resend_confirmation_link"), new_confirmation_path, class: "text-base-content/50 hover:text-base-content transition" %>
      </p>
    </div>
  </div>
</div>
