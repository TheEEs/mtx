<% content_for(:title, t("home.title")) %>

<div class="space-y-12">
  <!-- Minimal Hero -->
  <section class="py-6 sm:py-10 border-b border-base-200/80">
    <div class="max-w-2xl space-y-4">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-medium bg-base-200 text-base-content/70">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <%= t("home.badge") %>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-base-content">
        <%= t("home.hero_title") %>
      </h1>
      <p class="text-base sm:text-lg text-base-content/70 leading-relaxed">
        <%= t("home.hero_desc") %>
      </p>
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <%= link_to rooms_path, class: "btn btn-sm sm:btn-md btn-primary rounded-md font-medium px-5" do %>
          <%= t("home.explore_btn") %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        <% end %>

        <% if authenticated? %>
          <%= link_to new_room_path, class: "btn btn-sm sm:btn-md btn-ghost border border-base-content/15 rounded-md font-medium px-5" do %>
            <%= t("home.create_btn") %>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Live Channels Section -->
  <section class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-1">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-base-content">
          <%= t("home.channels_heading") %>
        </h2>
        <p class="text-xs sm:text-sm text-base-content/60 mt-0.5">
          <%= t("home.channels_subheading") %>
        </p>
      </div>
      <%= link_to rooms_path, class: "text-xs sm:text-sm text-base-content/70 hover:text-base-content font-medium transition flex items-center gap-1 shrink-0 self-start sm:self-auto" do %>
        <%= t("home.view_all", count: @rooms.size) %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      <% end %>
    </div>

    <% if @rooms.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        <% @rooms.each do |room| %>
          <div class="group flex flex-col justify-between rounded-xl border border-base-200/80 bg-base-100/60 p-4 sm:p-5 transition hover:border-base-content/20 hover:bg-base-100">
            <div class="space-y-3">
              <!-- Channel Status & Owner -->
              <div class="flex items-center justify-between gap-2 min-w-0">
                <span class="text-xs font-medium text-base-content/60 truncate min-w-0 flex-1" title="<%= room.owner %>">
                  <%= room.owner.presence || "MTX Streamer" %>
                </span>
                <div class="flex items-center gap-1.5 shrink-0">
                  <% unless room.is_public? %>
                    <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[11px] font-medium bg-amber-500/10 text-amber-500">
                      <% if room.password_protected? %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                      <% end %>
                      <%= t("rooms.private_badge") %>
                    </span>
                  <% end %>
                  <% if room.blocked %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-error/10 text-error">
                      <%= t("home.blocked") %>
                    </span>
                  <% elsif room.expired? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-base-content/10 text-base-content/60">
                      <%= t("home.expired") %>
                    </span>
                  <% else %>
                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-500/10 text-emerald-400">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                      <%= t("home.ready") %>
                    </span>
                  <% end %>
                </div>
              </div>

              <!-- Channel Title -->
              <div>
                <% if policy(room).show? %>
                  <%= link_to room_path(room), class: "font-semibold text-base sm:text-lg text-base-content group-hover:text-primary transition line-clamp-1 break-words" do %>
                    <%= room.name %>
                  <% end %>
                <% else %>
                  <span class="font-semibold text-base sm:text-lg text-base-content line-clamp-1 break-words"><%= room.name %></span>
                <% end %>
                <% if room.description.present? %>
                  <p class="text-xs text-base-content/60 mt-1 line-clamp-2 leading-relaxed break-words">
                    <%= room.description %>
                  </p>
                <% end %>
              </div>
            </div>

            <!-- Card Footer -->
            <div class="mt-4 sm:mt-5 pt-3 sm:pt-4 border-t border-base-200/60 flex items-center justify-between text-xs text-base-content/50 gap-2">
              <span class="truncate min-w-0">
                <%= local_time(room.created_at, :short) if room.created_at %>
              </span>
              <% if policy(room).show? %>
                <%= link_to room_path(room), class: "inline-flex items-center gap-1 font-medium text-base-content/80 group-hover:text-base-content transition shrink-0" do %>
                  <%= t("home.watch_stream") %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <!-- Minimal Empty State -->
      <div class="rounded-xl border border-dashed border-base-200 py-16 px-6 text-center">
        <div class="max-w-sm mx-auto space-y-3">
          <div class="w-10 h-10 rounded-full bg-base-200 flex items-center justify-center mx-auto text-base-content/50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </div>
          <p class="text-sm font-medium text-base-content"><%= t("home.empty_title") %></p>
          <p class="text-xs text-base-content/60"><%= t("home.empty_desc") %></p>
          <% if authenticated? %>
            <div class="pt-2">
              <%= link_to t("home.create_first"), new_room_path, class: "btn btn-xs sm:btn-sm btn-primary rounded-md" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
</div>
