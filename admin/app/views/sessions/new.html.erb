<% content_for :title, t("auth.sign_in") %>

<div class="max-w-md mx-auto py-8">
  <div class="rounded-xl border border-base-200/80 bg-base-100/60 p-6 sm:p-8 space-y-6">
    <div class="space-y-1 text-center">
      <h1 class="text-2xl font-bold tracking-tight text-base-content">
        <%= t("auth.sign_in") %>
      </h1>
      <p class="text-xs text-base-content/60">
        <%= t("auth.sign_in_desc") %>
      </p>
    </div>

    <% if alert = flash[:alert] %>
      <div class="p-3 rounded-lg border border-error/30 bg-error/10 text-error text-xs font-medium" id="alert">
        <%= alert %>
      </div>
    <% end %>

    <% if notice = flash[:notice] %>
      <div class="p-3 rounded-lg border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 text-xs font-medium" id="notice">
        <%= notice %>
      </div>
    <% end %>

    <%= form_with url: session_url, class: "space-y-4" do |form| %>
      <div class="space-y-1.5">
        <%= form.label :email_address, t("auth.email"), class: "text-xs font-medium text-base-content/80" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "admin@example.com", value: params[:email_address], class: "input input-bordered w-full rounded-md text-sm bg-base-100/70" %>
      </div>

      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <%= form.label :password, t("auth.password"), class: "text-xs font-medium text-base-content/80" %>
          <%= link_to t("auth.forgot_password"), new_password_path, class: "text-xs text-base-content/50 hover:text-base-content transition" %>
        </div>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••", maxlength: 72, class: "input input-bordered w-full rounded-md text-sm bg-base-100/70" %>
      </div>

      <div class="pt-2">
        <%= form.submit t("auth.sign_in"), class: "btn btn-primary w-full rounded-md font-medium text-sm cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
