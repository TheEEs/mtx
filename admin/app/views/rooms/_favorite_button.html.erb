<%= turbo_frame_tag "favorite_room_#{room.hashid}" do %>
  <% if authenticated? %>
    <% if current_user.favorited?(room) %>
      <%= button_to room_favorite_path(room),
                    method: :delete,
                    class: "btn btn-sm btn-ghost border border-amber-500/30 bg-amber-500/10 text-amber-500 rounded-md gap-1.5 text-xs font-medium cursor-pointer transition hover:bg-amber-500/20",
                    id: "unfavorite_room_btn_#{room.hashid}",
                    title: t("favorites.remove") do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 fill-current text-amber-500" viewBox="0 0 24 24">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
        </svg>
        <span><%= t("favorites.favorited") %></span>
      <% end %>
    <% else %>
      <%= button_to room_favorite_path(room),
                    method: :post,
                    class: "btn btn-sm btn-ghost border border-base-content/20 rounded-md gap-1.5 text-xs font-medium cursor-pointer transition hover:border-amber-500/40 hover:text-amber-500",
                    id: "favorite_room_btn_#{room.hashid}",
                    title: t("favorites.add") do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
        </svg>
        <span><%= t("favorites.add") %></span>
      <% end %>
    <% end %>
  <% else %>
    <%= link_to new_session_path,
                class: "btn btn-sm btn-ghost border border-base-content/20 rounded-md gap-1.5 text-xs font-medium cursor-pointer transition hover:border-amber-500/40",
                title: t("favorites.login_required"),
                data: { turbo: false } do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
      </svg>
      <span><%= t("favorites.add") %></span>
    <% end %>
  <% end %>
<% end %>
