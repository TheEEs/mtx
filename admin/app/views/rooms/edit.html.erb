<% content_for :title, t("actions.edit", model: Room.model_name.human) %>

<div class="max-w-2xl mx-auto space-y-6">
  <div class="border-b border-base-200/80 pb-4">
    <div class="flex items-center gap-2 text-xs text-base-content/60 mb-2">
      <%= link_to t("nav.rooms"), rooms_path, class: "hover:underline" %>
      <span>/</span>
      <%= link_to @room.name, @room, class: "hover:underline" %>
      <span>/</span>
      <span><%= t("actions.edit", model: "") %></span>
    </div>
    <h1 class="text-2xl font-bold tracking-tight text-base-content">
      <%= t("actions.edit", model: Room.model_name.human) %>
    </h1>
    <p class="text-xs text-base-content/60 mt-1">
      <%= t("room_form.edit_desc") %>
    </p>
  </div>

  <div class="rounded-xl border border-base-200/80 bg-base-100/50 p-6 sm:p-8">
    <%= render "form", room: @room %>
  </div>
</div>
