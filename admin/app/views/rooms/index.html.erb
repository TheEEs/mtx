<% content_for :title, t("activerecord.models.room") %>

<div class="space-y-6">
  <% if notice.present? %>
    <div class="flex items-center justify-between gap-3 px-4 py-3 rounded-lg border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 text-sm">
      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span><%= notice %></span>
      </div>
    </div>
  <% end %>

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-2 border-b border-base-200/80">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-base-content">
        <%= t("rooms_view.title") %>
      </h1>
      <p class="text-sm text-base-content/60 mt-1">
        <%= t("rooms_view.desc") %>
      </p>
    </div>

    <%= link_to new_room_path, class: "btn btn-sm btn-primary rounded-md px-4 font-medium inline-flex items-center gap-1.5" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      <%= t("actions.new", model: Room.model_name.human) %>
    <% end %>
  </div>

  <!-- Rooms Table -->
  <div class="rounded-xl border border-base-200/80 bg-base-100/50 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-base-200/80 bg-base-200/30 text-xs font-medium text-base-content/60 uppercase tracking-wider">
            <th class="py-3 px-4 sm:px-6"><%= Room.human_attribute_name(:name) %></th>
            <th class="py-3 px-4 hidden md:table-cell"><%= Room.human_attribute_name(:owner) %></th>
            <th class="py-3 px-4 hidden lg:table-cell"><%= t("rooms_view.headers.time") %></th>
            <th class="py-3 px-4 text-center"><%= t("rooms_view.headers.status") %></th>
            <th class="py-3 px-4 sm:px-6 text-right"><%= t("rooms_view.headers.actions") %></th>
          </tr>
        </thead>
        <tbody id="rooms" class="divide-y divide-base-200/60">
          <% if @rooms.any? %>
            <%= render @rooms %>
          <% else %>
            <tr>
              <td colspan="5" class="py-16 text-center text-base-content/50">
                <div class="flex flex-col items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 stroke-current opacity-40" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                  <p class="text-sm font-medium"><%= t("rooms_view.empty") %></p>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
