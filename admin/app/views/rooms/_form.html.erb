<%= form_with(model: room, class: "space-y-5") do |form| %>
  <% if room.errors.any? %>
    <div class="p-4 rounded-lg border border-error/30 bg-error/10 text-error text-sm space-y-1">
      <div class="font-medium flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <%= t "activerecord.errors.template.header.other", model: Room.model_name.human, count: room.errors.count %>
      </div>
      <ul class="list-disc list-inside text-xs space-y-0.5 opacity-90 pl-5">
        <% room.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="space-y-1.5">
      <%= form.label :name, class: "text-xs font-medium text-base-content/80" do %>
        <%= Room.human_attribute_name(:name) %> <% if Room.required?(:name) %><span class="text-error">*</span><% end %>
      <% end %>
      <%= form.text_field :name, placeholder: t("room_form.name_placeholder"), class: "input input-bordered w-full rounded-md text-sm bg-base-100/60 #{'input-error' if room.errors[:name].any?}" %>
    </div>

    <div class="space-y-1.5">
      <%= form.label :owner, class: "text-xs font-medium text-base-content/80" do %>
        <%= Room.human_attribute_name(:owner) %> <% if Room.required?(:owner) %><span class="text-error">*</span><% end %>
      <% end %>
      <%= form.text_field :owner, placeholder: t("room_form.owner_placeholder"), class: "input input-bordered w-full rounded-md text-sm bg-base-100/60 #{'input-error' if room.errors[:owner].any?}" %>
    </div>
  </div>

  <div class="space-y-1.5">
    <%= form.label :description, class: "text-xs font-medium text-base-content/80" do %>
      <%= Room.human_attribute_name(:description) %> <% if Room.required?(:description) %><span class="text-error">*</span><% end %>
    <% end %>
    <%= form.textarea :description, rows: 3, placeholder: t("room_form.description_placeholder"), class: "textarea textarea-bordered w-full rounded-md text-sm bg-base-100/60 leading-relaxed #{'textarea-error' if room.errors[:description].any?}" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="space-y-1.5">
      <%= form.label :valid_from, class: "text-xs font-medium text-base-content/80" do %>
        <%= Room.human_attribute_name(:valid_from) %> <% if Room.required?(:valid_from) %><span class="text-error">*</span><% end %>
      <% end %>
      <%= form.datetime_field :valid_from, class: "input input-bordered w-full rounded-md text-sm bg-base-100/60 #{'input-error' if room.errors[:valid_from].any?}" %>
    </div>

    <div class="space-y-1.5">
      <%= form.label :valid_to, class: "text-xs font-medium text-base-content/80" do %>
        <%= Room.human_attribute_name(:valid_to) %> <% if Room.required?(:valid_to) %><span class="text-error">*</span><% end %>
      <% end %>
      <%= form.datetime_field :valid_to, class: "input input-bordered w-full rounded-md text-sm bg-base-100/60 #{'input-error' if room.errors[:valid_to].any?}" %>
    </div>
  </div>

  <%= form.hidden_field :timezone, data: { controller: "timezone" } %>

  <div class="rounded-lg border border-base-200/80 bg-base-100/40 p-4 space-y-4" data-controller="room-form">
    <div class="flex items-start justify-between gap-4">
      <div class="space-y-0.5">
        <%= form.label :is_public, t("room_form.is_public_label"), class: "text-sm font-medium text-base-content cursor-pointer" %>
        <p class="text-xs text-base-content/60 leading-relaxed">
          <%= t("room_form.is_public_hint") %>
        </p>
      </div>
      <%= form.check_box :is_public, 
            id: "room_is_public",
            class: "toggle toggle-primary toggle-sm sm:toggle-md mt-0.5 cursor-pointer shrink-0",
            data: { 
              room_form_target: "isPublic",
              action: "change->room-form#togglePassword" 
            } %>
    </div>

    <!-- Password input: only active when room_is_public toggle is off -->
    <div data-room-form-target="passwordContainer" class="pt-3 border-t border-base-200/60 space-y-1.5 <%= 'hidden' if room.is_public? %>">
      <%= form.label :password, class: "text-xs font-medium text-base-content/80 flex flex-wrap items-center justify-between gap-1" do %>
        <span class="inline-flex items-center gap-1.5">
          <%= Room.human_attribute_name(:password) %>
          <span class="text-[11px] font-normal text-base-content/50">(<%= t("room_form.optional") %>)</span>
        </span>
        <% if room.persisted? && room.password_digest.present? %>
          <span class="text-[11px] text-base-content/50 font-normal">
            <%= t("room_form.password_keep_blank_hint") %>
          </span>
        <% end %>
      <% end %>
      <%= form.password_field :password,
            id: "room_password",
            placeholder: t("room_form.password_placeholder"),
            autocomplete: "new-password",
            class: "input input-bordered w-full rounded-md text-sm bg-base-100/60 #{'input-error' if room.errors[:password].any?}",
            disabled: room.is_public?,
            data: { room_form_target: "passwordInput" } %>
      <p class="text-[11px] text-base-content/60">
        <%= t("room_form.password_hint") %>
      </p>
    </div>
  </div>

  <div class="pt-4 flex items-center gap-3">
    <%= form.submit (room.persisted? ? t("room_form.update") : t("room_form.create")), class: "btn btn-sm btn-primary rounded-md px-6 font-medium cursor-pointer" %>
    <%= link_to t("actions.back"), rooms_path, class: "btn btn-sm btn-ghost rounded-md text-xs text-base-content/60 hover:text-base-content" %>
  </div>
<% end %>
