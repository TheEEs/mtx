<tr class="hover:bg-base-200/40 transition-colors">
  <td class="py-3.5 px-4 sm:px-6">
    <div class="font-medium text-base-content">
      <%= link_to room.name, room, class: "hover:underline" %>
    </div>
    <% if room.description.present? %>
      <div class="text-xs text-base-content/50 truncate max-w-xs mt-0.5">
        <%= room.description %>
      </div>
    <% end %>
    <div class="text-xs text-base-content/50 md:hidden mt-1">
      <%= room.owner %>
    </div>
  </td>

  <td class="py-3.5 px-4 hidden md:table-cell text-base-content/70">
    <%= room.owner.presence || "-" %>
  </td>

  <td class="py-3.5 px-4 hidden lg:table-cell text-xs text-base-content/60">
    <% if room.valid_from.present? || room.valid_to.present? %>
      <div><%= local_time(room.valid_from, :short) if room.valid_from %></div>
      <div class="text-base-content/40"><%= t("rooms_view.to") %> <%= local_time(room.valid_to, :short) if room.valid_to %></div>
    <% else %>
      <span class="text-base-content/40"><%= t("rooms_view.unlimited") %></span>
    <% end %>
  </td>

  <td class="py-3.5 px-4 text-center">
    <% if room.blocked %>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-error/10 text-error">
        <%= t("rooms_view.status_blocked") %>
      </span>
    <% elsif room.expired? %>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-base-content/10 text-base-content/60">
        <%= t("rooms_view.status_expired") %>
      </span>
    <% elsif room.not_started? %>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-base-content/10 text-base-content/60">
        <%= t("rooms_view.status_not_started") %>
      </span>
    <% else %>
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-500/10 text-emerald-400">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <%= t("rooms_view.status_open") %>
      </span>
    <% end %>
  </td>

  <td class="py-3.5 px-4 sm:px-6 text-right">
    <div class="inline-flex items-center gap-1">
      <%= link_to room, class: "p-1.5 rounded text-base-content/60 hover:text-base-content hover:bg-base-200 transition", title: t("rooms_view.view_channel") do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
      <% end %>

      <%= link_to edit_room_path(room), class: "p-1.5 rounded text-base-content/60 hover:text-base-content hover:bg-base-200 transition", title: t("rooms_view.edit_channel") do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
      <% end %>

      <%= button_to room, method: :delete, class: "p-1.5 rounded text-base-content/40 hover:text-error hover:bg-error/10 transition cursor-pointer", title: t("rooms_view.delete_channel"), data: { turbo_confirm: t("rooms_view.confirm_delete") } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      <% end %>
    </div>
  </td>
</tr>
