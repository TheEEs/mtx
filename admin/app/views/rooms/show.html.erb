<% content_for(:title, @room.name) %>

<div <%= %(data-video-token-value="#{h(@room.jwt)}" data-video-url-value="#{h(@whepURL)}" data-video-room-id-value="#{h(@room.hashid)}" data-video-live-text-value="#{t('room_show.status_live')}" data-video-idle-text-value="#{t('room_show.status_idle')}" data-controller="video#{' screen-share' if policy(@room).toggle_stream?}" #{%(data-screen-share-token-value="#{h(@room.jwt)}" data-screen-share-url-value="#{h(@whepURL)}" data-screen-share-room-id-value="#{h(@room.hashid)}" data-screen-share-connected-text-value="#{t('screen_share.connected')}" data-screen-share-connecting-text-value="#{t('screen_share.connecting')}") if policy(@room).toggle_stream?}).html_safe if @room.available? %>
     class="space-y-6 max-w-4xl mx-auto"
>
  <% if notice.present? %>
    <div class="flex items-center gap-2 px-4 py-3 rounded-lg border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 text-sm">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <span><%= notice %></span>
    </div>
  <% end %>

  <% if policy(@room).toggle_stream? && @room.available? %>
    <!-- Screen Share Active Streaming Banner -->
    <div data-screen-share-target="activeBanner" class="hidden rounded-xl border border-error/40 bg-error/10 p-4 text-xs">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div class="flex items-center gap-2.5">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-error opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-error"></span>
          </span>
          <span class="font-semibold text-error"><%= t("screen_share.streaming_now") %></span>
          <span class="text-base-content/40">•</span>
          <span data-screen-share-target="duration" class="font-mono font-medium text-base-content">00:00</span>
          <span class="text-base-content/40">•</span>
          <span data-screen-share-target="status" class="text-base-content/70"><%= t("screen_share.connected") %></span>
        </div>

        <button type="button"
                data-action="click->screen-share#stop"
                class="btn btn-xs btn-error text-white gap-1 rounded cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
          <%= t("screen_share.stop") %>
        </button>
      </div>
    </div>
  <% end %>

  <!-- Back Link & Top Meta -->
  <div class="flex items-center justify-between text-xs text-base-content/60">
    <%= link_to rooms_path, class: "inline-flex items-center gap-1.5 hover:text-base-content transition" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <%= t("room_show.back") %>
    <% end %>

    <div class="flex items-center gap-2">
      <% if policy(@room).edit? %>
        <%= link_to edit_room_path(@room), class: "hover:text-base-content transition" do %>
          <%= t("room_show.edit") %>
        <% end %>
        <span>•</span>
      <% end %>
      <span>ID: <code class="font-mono text-[11px] text-base-content/80"><%= @room.hashid %></code></span>
    </div>
  </div>

  <!-- Video Area: Notice if expired, Video Player if active -->
  <% if not @room.available? %>
    <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-base-100/60 border border-base-200/80 flex flex-col items-center justify-center p-6 text-center">
      <div class="w-12 h-12 rounded-full bg-base-200 flex items-center justify-center text-base-content/40 mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h2 class="text-base sm:text-lg font-semibold text-base-content">
        <%= t("room_show.unavailable_title") %>
      </h2>
      <p class="text-xs sm:text-sm text-base-content/60 max-w-md mt-1.5 leading-relaxed">
        <%= t("room_show.unavailable_desc") %>
      </p>
      <div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-base-200/60 text-xs text-base-content/70">
        <% if @room.not_started? %>
          <span class="text-base-content/50"><%= Room.human_attribute_name(:valid_from) %>:</span>
          <span class="font-medium"><%= local_time(@room.valid_from, :long) %></span>
        <% elsif @room.expired? %>
          <span class="text-base-content/50"><%= Room.human_attribute_name(:valid_to) %>:</span>
          <span class="font-medium"><%= local_time(@room.valid_to, :long) %></span>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render partial: "video", room: @room %>
  <% end %>

  <!-- Stream Header & Controls -->
  <div class="space-y-4 rounded-xl border border-base-200/80 bg-base-100/50 p-4 sm:p-5">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
          <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-base-content break-words">
            <%= @room.name %>
          </h1>

          <div class="flex flex-wrap items-center gap-1.5 shrink-0">
            <!-- Live / Expired Status Badge -->
            <% if @room.expired? %>
              <span class="badge badge-error/15 text-error gap-1.5 text-xs font-medium py-1 px-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                <%= t("room_show.status_expired") %>
              </span>
            <% else %>
              <span data-video-target="badge" class="badge badge-neutral gap-1.5 text-xs font-medium py-1 px-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                <span data-video-target="badgeText"><%= t("room_show.status_idle") %></span>
              </span>
            <% end %>

            <!-- Public / Private Visibility Badge -->
            <% if @room.is_public? %>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-info/10 text-info">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <%= t("room_show.public_badge") %>
              </span>
            <% else %>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-warning/10 text-warning">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <%= t("room_show.private_badge") %>
              </span>
            <% end %>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-base-content/60 mt-1.5">
          <span><%= t("room_show.broadcaster") %> <strong class="text-base-content/80 font-medium"><%= @room.owner.presence || "MTX" %></strong></span>
          <% if @room.valid_from.present? || @room.valid_to.present? %>
            <span>•</span>
            <span>
              <%= local_time(@room.valid_from, :short) if @room.valid_from %>
              <% if @room.valid_to %>
                - <%= local_time(@room.valid_to, :short) %>
              <% end %>
            </span>
          <% end %>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto justify-start sm:justify-end">
        <!-- Web Share API Button -->
        <button type="button"
                data-controller="share"
                data-share-title-value="<%= @room.name %>"
                data-share-text-value="<%= t("room_show.share_text", name: @room.name) %>"
                data-share-url-value="<%= room_url(@room) %>"
                data-action="click->share#share"
                class="hidden btn btn-sm btn-ghost border border-base-content/20 rounded-md gap-1.5 text-xs font-medium cursor-pointer"
                id="share_room_<%= @room.hashid %>"
                title="<%= t("actions.share") %>"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          <span><%= t("actions.share") %></span>
        </button>

        <% if policy(@room).toggle_stream? && @room.available? %>
          <!-- Screen Share Button -->
          <button type="button"
                  data-action="click->screen-share#open"
                  class="btn btn-sm btn-primary rounded-md gap-1.5 text-xs font-medium cursor-pointer"
                  id="screen_share_btn"
                  title="<%= t("screen_share.button") %>"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span><%= t("screen_share.button") %></span>
          </button>

          <%= button_to toggle_stream_path(@room), method: :delete, class: "btn btn-sm btn-ghost border border-base-content/20 rounded-md gap-1.5 text-xs font-medium cursor-pointer", id: "toggle_stream_#{@room.hashid}_1" do %>
            <% if @room.blocked %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 10.5V6.75a4.5 4.5 0 1 1 9 0v3.75M3.75 21.75h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H3.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
              </svg>
              <%= t("actions.stream.open") %>
            <% else %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
              </svg>
              <%= t("actions.stream.kick") %>
            <% end %>
          <% end %>
        <% end %>

        <!-- Hidden anchor for Turbo Stream stream target 2 -->
        <span class="hidden" id="toggle_stream_#{@room.hashid}_2"></span>
      </div>
    </div>

    <% if @room.description.present? %>
      <div class="pt-3 border-t border-base-200/60 text-sm text-base-content/80 leading-relaxed">
        <%= simple_format(@room.description) %>
      </div>
    <% end %>
  </div>

  <% if policy(@room).toggle_stream? %>
    <!-- WHIP Ingestion Config Box (Owner Only) -->
    <% if @room.expired? %>
      <div class="rounded-xl border border-base-200/80 bg-base-100/50 p-5 space-y-2">
        <div class="flex items-center gap-2 text-sm font-semibold text-base-content/80">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-base-content/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <%= t("room_show.whip_closed_title") %>
        </div>
        <p class="text-xs text-base-content/60">
          <%= t("room_show.whip_closed_desc") %>
        </p>
      </div>
    <% else %>
      <div class="rounded-xl border border-base-200/80 bg-base-100/50 p-5 space-y-4">
        <div class="border-b border-base-200/60 pb-3">
          <h2 class="text-sm font-semibold text-base-content">
            <%= t("room_show.whip_title") %>
          </h2>
          <p class="text-xs text-base-content/60 mt-0.5">
            <%= t("room_show.whip_desc") %>
          </p>
        </div>

        <div class="space-y-3 text-xs">
          <!-- Screen Sharing Quick Action Card -->
          <div class="p-3.5 rounded-lg border border-primary/20 bg-primary/5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <h3 class="text-xs font-semibold text-base-content flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <%= t("screen_share.box_title") %>
              </h3>
              <p class="text-[11px] text-base-content/60 mt-0.5">
                <%= t("screen_share.box_desc") %>
              </p>
            </div>
            <button type="button"
                    data-action="click->screen-share#open"
                    class="btn btn-sm btn-primary rounded-md text-xs font-medium cursor-pointer shrink-0 inline-flex items-center gap-1.5"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span><%= t("screen_share.button") %></span>
            </button>
          </div>

          <!-- WHIP URL -->
          <div>
            <label class="block font-medium text-base-content/70 mb-1"><%= t("room_show.whip_url") %></label>
            <div class="flex items-center gap-2">
              <div class="flex-1 font-mono text-[11px] p-2.5 rounded-md bg-base-200/60 border border-base-200 text-base-content/90 overflow-x-auto select-all">
                <span data-video-target="whipUrl"><%= t("room_show.whip_loading") %></span>
              </div>
            </div>
          </div>

          <!-- Bearer Token -->
          <div>
            <label class="block font-medium text-base-content/70 mb-1"><%= t("room_show.token") %></label>
            <div class="flex items-center gap-2">
              <div class="flex-1 min-w-0 font-mono text-[11px] p-2.5 rounded-md bg-base-200/60 border border-base-200 text-base-content/90 truncate select-all">
                <%= @room.jwt %>
              </div>
              <button type="button"
                      data-video-copied-param="<%= t("actions.copied") %>" 
                      data-action="click->video#copyTokenToClipboard" 
                      class="btn btn-sm btn-ghost border border-base-content/15 rounded-md text-xs font-medium shrink-0 inline-flex items-center gap-1.5 cursor-pointer"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span data-video-target="tokenCopied"><%= t("actions.copy") %></span>
              </button>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <!-- Dummy hidden span for Turbo Stream target -->
    <span class="hidden" data-video-target="whipUrl"></span>
  <% end %>

  <% if policy(@room).toggle_stream? && @room.available? %>
    <!-- Screen Share Modal (Configuration & Browser Support Error Handling) -->
    <dialog data-screen-share-target="modal" class="modal">
      <div class="modal-box max-w-md bg-base-100 border border-base-200">
        <!-- View 1: Browser Not Supported Error View -->
        <div data-screen-share-target="unsupportedView" class="hidden space-y-4">
          <div class="flex items-center gap-3 text-error">
            <div class="p-2 rounded-full bg-error/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-base"><%= t("screen_share.unsupported_title") %></h3>
              <p class="text-[11px] text-base-content/50 font-mono">navigator.mediaDevices.getDisplayMedia</p>
            </div>
          </div>

          <p class="text-xs text-base-content/70 leading-relaxed">
            <%= t("screen_share.unsupported_desc") %>
          </p>

          <div class="modal-action">
            <button type="button" class="btn btn-sm btn-ghost cursor-pointer" data-action="click->screen-share#closeModal">
              <%= t("actions.close") %>
            </button>
          </div>
        </div>

        <!-- View 2: Supported Configuration View -->
        <div data-screen-share-target="configView" class="space-y-4">
          <div class="border-b border-base-200/60 pb-3">
            <h3 class="font-bold text-base text-base-content flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <%= t("screen_share.config_title") %>
            </h3>
            <p class="text-xs text-base-content/60 mt-1">
              <%= t("screen_share.config_desc") %>
            </p>
          </div>

          <div class="space-y-3.5 text-xs">
            <!-- Video Codec Dropdown -->
            <div>
              <label class="block font-medium text-base-content/80 mb-1">
                <%= t("screen_share.video_codec") %>
              </label>
              <select data-screen-share-target="videoCodecSelect" class="select select-sm select-bordered w-full text-xs font-mono">
              </select>
              <span class="text-[10px] text-base-content/50 mt-1 block">
                <%= t("screen_share.video_codec_hint") %>
              </span>
            </div>

            <!-- Audio Codec Dropdown -->
            <div>
              <label class="block font-medium text-base-content/80 mb-1">
                <%= t("screen_share.audio_codec") %>
              </label>
              <select data-screen-share-target="audioCodecSelect" class="select select-sm select-bordered w-full text-xs font-mono">
              </select>
              <span class="text-[10px] text-base-content/50 mt-1 block">
                <%= t("screen_share.audio_codec_hint") %>
              </span>
            </div>

            <!-- Include Audio Toggle -->
            <label class="flex items-center gap-2 cursor-pointer pt-1">
              <input type="checkbox" data-screen-share-target="includeAudioCheckbox" checked class="checkbox checkbox-xs checkbox-primary" />
              <span class="text-xs text-base-content/80"><%= t("screen_share.include_audio") %></span>
            </label>

            <!-- Error message container -->
            <div data-screen-share-target="errorAlert" class="hidden p-2.5 rounded-lg border border-error/30 bg-error/10 text-error text-xs">
              <span data-screen-share-target="errorMessage"></span>
            </div>
          </div>

          <div class="modal-action">
            <button type="button" class="btn btn-sm btn-ghost cursor-pointer" data-action="click->screen-share#closeModal">
              <%= t("actions.cancel") %>
            </button>
            <button type="button"
                    data-screen-share-target="startShareButton"
                    data-action="click->screen-share#startSharing"
                    class="btn btn-sm btn-primary gap-1.5 cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              </svg>
              <%= t("screen_share.start_button") %>
            </button>
          </div>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button type="button" data-action="click->screen-share#closeModal">close</button>
      </form>
    </dialog>
  <% end %>
</div>
