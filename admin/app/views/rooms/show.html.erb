<% content_for(:title, @room.name) %>

<div <%= %(data-video-token-value="#{@room.jwt}" data-video-url-value="#{@whepURL}" data-video-room-id-value="#{@room.hashid}" data-video-live-text-value="#{t('room_show.status_live')}" data-video-idle-text-value="#{t('room_show.status_idle')}" data-controller="video").html_safe if @room.available? %>
     class="space-y-6 max-w-4xl mx-auto"
>
  <% if notice.present? %>
    <div class="flex items-center gap-2 px-4 py-3 rounded-lg border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 text-sm">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <span><%= notice %></span>
    </div>
  <% end %>

  <!-- Back Link & Top Meta -->
  <div class="flex items-center justify-between text-xs text-base-content/60">
    <%= link_to rooms_path, class: "inline-flex items-center gap-1.5 hover:text-base-content transition" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <%= t("room_show.back") %>
    <% end %>

    <div class="flex items-center gap-2">
      <% if policy(@room).edit? %>
        <%= link_to edit_room_path(@room), class: "hover:text-base-content transition" do %>
          <%= t("room_show.edit") %>
        <% end %>
        <span>•</span>
      <% end %>
      <span>ID: <code class="font-mono text-[11px] text-base-content/80"><%= @room.hashid %></code></span>
    </div>
  </div>

  <!-- Video Area: Notice if expired, Video Player if active -->
  <% if not @room.available? %>
    <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-base-100/60 border border-base-200/80 flex flex-col items-center justify-center p-6 text-center">
      <div class="w-12 h-12 rounded-full bg-base-200 flex items-center justify-center text-base-content/40 mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h2 class="text-base sm:text-lg font-semibold text-base-content">
        <%= t("room_show.unavailable_title") %>
      </h2>
      <p class="text-xs sm:text-sm text-base-content/60 max-w-md mt-1.5 leading-relaxed">
        <%= t("room_show.unavailable_desc") %>
      </p>
      <div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-base-200/60 text-xs text-base-content/70">
        <% if @room.not_started? %>
          <span class="text-base-content/50"><%= Room.human_attribute_name(:valid_from) %>:</span>
          <span class="font-medium"><%= local_time(@room.valid_from, :long) %></span>
        <% elsif @room.expired? %>
          <span class="text-base-content/50"><%= Room.human_attribute_name(:valid_to) %>:</span>
          <span class="font-medium"><%= local_time(@room.valid_to, :long) %></span>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render partial: "video", room: @room %>
  <% end %>

  <!-- Stream Header & Controls -->
  <div class="space-y-4 rounded-xl border border-base-200/80 bg-base-100/50 p-5">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-base-content">
            <%= @room.name %>
          </h1>

          <!-- Live / Expired Status Badge -->
          <% if @room.expired? %>
            <span class="badge badge-error/15 text-error gap-1.5 text-xs font-medium py-1 px-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
              <%= t("room_show.status_expired") %>
            </span>
          <% else %>
            <span data-video-target="badge" class="badge badge-neutral gap-1.5 text-xs font-medium py-1 px-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
              <span data-video-target="badgeText"><%= t("room_show.status_idle") %></span>
            </span>
          <% end %>
        </div>

        <div class="flex flex-wrap items-center gap-3 text-xs text-base-content/60 mt-1.5">
          <span><%= t("room_show.broadcaster") %> <strong class="text-base-content/80 font-medium"><%= @room.owner.presence || "MTX" %></strong></span>
          <% if @room.valid_from.present? || @room.valid_to.present? %>
            <span>•</span>
            <span>
              <%= local_time(@room.valid_from, :short) if @room.valid_from %>
              <% if @room.valid_to %>
                - <%= local_time(@room.valid_to, :short) %>
              <% end %>
            </span>
          <% end %>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2 shrink-0">
        <% if @room.available? %>
          <%= button_to toggle_stream_path(@room), method: :delete, class: "btn btn-sm btn-ghost border border-base-content/20 rounded-md gap-1.5 text-xs font-medium cursor-pointer", id: "toggle_stream_#{@room.hashid}_1" do %>
            <% if @room.blocked %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 10.5V6.75a4.5 4.5 0 1 1 9 0v3.75M3.75 21.75h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H3.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
              </svg>
              <%= t("actions.stream.open") %>
            <% else %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
              </svg>
              <%= t("actions.stream.kick") %>
            <% end %>
          <% end %>
        <% end %>

        <!-- Hidden anchor for Turbo Stream stream target 2 -->
        <span class="hidden" id="toggle_stream_#{@room.hashid}_2"></span>
      </div>
    </div>

    <% if @room.description.present? %>
      <div class="pt-3 border-t border-base-200/60 text-sm text-base-content/80 leading-relaxed">
        <%= simple_format(@room.description) %>
      </div>
    <% end %>
  </div>

  <!-- WHIP Ingestion Config Box -->
  <% if @room.expired? %>
    <div class="rounded-xl border border-base-200/80 bg-base-100/50 p-5 space-y-2">
      <div class="flex items-center gap-2 text-sm font-semibold text-base-content/80">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-base-content/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <%= t("room_show.whip_closed_title") %>
      </div>
      <p class="text-xs text-base-content/60">
        <%= t("room_show.whip_closed_desc") %>
      </p>
    </div>
  <% else %>
    <div class="rounded-xl border border-base-200/80 bg-base-100/50 p-5 space-y-4">
      <div class="border-b border-base-200/60 pb-3">
        <h2 class="text-sm font-semibold text-base-content">
          <%= t("room_show.whip_title") %>
        </h2>
        <p class="text-xs text-base-content/60 mt-0.5">
          <%= t("room_show.whip_desc") %>
        </p>
      </div>

      <div class="space-y-3 text-xs">
        <!-- WHIP URL -->
        <div>
          <label class="block font-medium text-base-content/70 mb-1"><%= t("room_show.whip_url") %></label>
          <div class="flex items-center gap-2">
            <div class="flex-1 font-mono text-[11px] p-2.5 rounded-md bg-base-200/60 border border-base-200 text-base-content/90 overflow-x-auto select-all">
              <span data-video-target="whipUrl"><%= t("room_show.whip_loading") %></span>
            </div>
          </div>
        </div>

        <!-- Bearer Token -->
        <div>
          <label class="block font-medium text-base-content/70 mb-1"><%= t("room_show.token") %></label>
          <div class="flex items-center gap-2">
            <div class="flex-1 font-mono text-[11px] p-2.5 rounded-md bg-base-200/60 border border-base-200 text-base-content/90 truncate select-all">
              <%= @room.jwt %>
            </div>
            <button type="button"
                    data-video-copied-param="<%= t("actions.copied") %>" 
                    data-action="click->video#copyTokenToClipboard" 
                    class="btn btn-sm btn-ghost border border-base-content/15 rounded-md text-xs font-medium shrink-0 inline-flex items-center gap-1.5 cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span data-video-target="tokenCopied"><%= t("actions.copy") %></span>
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
