<footer class="mt-auto border-t border-base-200/80 bg-base-100/40 py-6 text-xs text-base-content/60">
  <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="font-semibold text-base-content">MTX Live</span>
        <span>•</span>
        <span><%= t("footer.subtitle") %></span>
      </div>

      <div class="flex items-center gap-4 text-base-content/50">
        <%= link_to t("footer.channels"), rooms_path, class: "hover:text-base-content transition" %>
        <span>•</span>
        <span>© <%= Time.current.year %> MTX</span>
      </div>
    </div>
  </div>
</footer>
